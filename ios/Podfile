platform :ios, '17.0'
project 'MeanVC2/MeanVC2.xcodeproj'

use_frameworks!

target 'MeanVC2' do
  pod 'onnxruntime-objc', '1.24.3'
end

# Xcode 26.3 currently diagnoses quoted sibling-header imports in this
# upstream framework as malformed. Keep the documented workaround scoped
# to the ONNX Runtime Objective-C pod target.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    next unless target.name == 'onnxruntime-objc'

    target.build_configurations.each do |config|
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
    end
  end
end
